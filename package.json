{
  "name": "board-game-universe",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bgu/web dev",
    "dev:api": "pnpm --filter @bgu/api dev",
    "dev:realtime": "pnpm --filter @bgu/realtime dev",
    "dev:mcp": "pnpm --filter @bgu/mcp-gateway dev",
    "lint": "node tools/check-source.mjs && eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test tools/tests/*.test.mjs && pnpm --filter @bgu/api test",
    "build": "pnpm --filter @bgu/web build",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "agent:validate": "node tools/agent-task.mjs validate tools/examples/task-bgu-001.json",
    "security:secrets": "python3 scripts/check_secrets.py",
    "security:audit": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.46.0"
  }
}
